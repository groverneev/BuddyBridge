# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=            # only needed for `bun run gen:types`

# Email (Resend)
RESEND_API_KEY=
ADMIN_EMAIL=
RESEND_FROM=                    # optional, e.g. "BuddyBridge <hello@buddybridge.us>" once the domain is verified

# Cloudflare Turnstile (spam protection) — leave blank to disable locally
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (error tracking) — leave blank to disable
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
